{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift Coach",
  "version": "0.1.0",
  "identifier": "com.riftcoach.app",
  "build": {
    "frontendDist": "../../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Rift Coach",
    "shortDescription": "Rift Coach - League of Legends overlay coach",
    "resources": {
      "../../scripts/replay-fog.ps1": "scripts/replay-fog.ps1"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "template": "../packaging/nsis/installer.nsi",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "Polish"],
        "customLanguageFiles": { "Polish": "../packaging/nsis/Polish.nsh" },
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
